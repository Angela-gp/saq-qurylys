# Optional OpenAI-compatible API. The app works without a key using local RU/KZ rules.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Required for stable signed sessions. Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_HTTPS_ONLY=false

# Optional first-run passwords for the fictional seeded accounts.
# If blank, `make seed` generates one-time passwords and prints them once.
SAQ_PASSWORD_ANALYST=
SAQ_PASSWORD_ANALYST_BACKUP=
SAQ_PASSWORD_OBSERVER=

# Optional SQLite path; the default is backend/data/saq_qurylys.db
# DATABASE_URL=sqlite:///./backend/data/saq_qurylys.db
